buildconfig = "//third_party/connectedhomeip/build/config/BUILDCONFIG.gn"
check_system_includes = true
script_executable = "python3"
default_args = {
  import("//third_party/connectedhomeip/config/standalone/args.gni")
  chip_build_controller = true
  chip_build_tools = false
  chip_build_tests = false
  chip_enable_ble = false
  chip_config_network_layer_ble = false
  chip_enable_wifi = false
  chip_enable_thread = false
  chip_support_thread_meshcop = false
  chip_mdns = "minimal"
  chip_device_platform = "linux"
}
